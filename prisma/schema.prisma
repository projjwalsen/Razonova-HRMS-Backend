// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum TenantStatus {
  PENDING
  APPROVED
  REJECTED
}

model Tenant { // COMPANY
  id        String   @id @default(uuid())
  name      String

  status    TenantStatus  @default(PENDING) //🔥 WAIT FOR APPROVAL
  isActive  Boolean  @default(true)
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  roles     Role[]
  organization Organization[]
  settings   Setting[]
  departments Department[]
  designations Designation[]
  tenantSubscription TenantSubscription[]
  onboardingInvites OnboardingInvite[]
  attendanceConfigs AttendanceConfig[]
  attendances Attendance[]
  leaveTypes LeaveType[]
  leaveRequests LeaveRequest[]
  payrolls Payroll[]
  payStructures PayStructure[]
}

enum RoleType {
  SYSTEM
  TENANT
}
model Role {
  id        String   @id @default(uuid())
  name      String
  type      RoleType
  tenantId  String?
  tenant    Tenant?   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userRoles UserRole[]
  rolePermissions RolePermission[]
  onboardingInvites OnboardingInvite[]

  @@unique([name, tenantId]) // Ensure role names are unique within a tenant
}

model Permission {
  id        String   @id @default(uuid())
  name      String   
  scope     RoleType @default(SYSTEM)   // e.g., SYSTEM | TENANT
  module    String?   // e.g., EMPLOYEE_MANAGEMENT
  action    String?   // e.g., CREATE, READ, UPDATE, DELETE
  
  createdAt DateTime @default(now())

  roles     RolePermission[]

  @@unique([scope, module, action]) // Ensure unique permissions based on scope, module, and action
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?  @unique
  password  String

  tenantId  String?
  tenant    Tenant?   @relation(fields: [tenantId], references: [id]) // COMPANY

  departmentId String?
  department   Department? @relation("DepartmentUsers", fields: [departmentId], references: [id])

  designationId String?
  designation   Designation? @relation(fields: [designationId], references: [id])

  managerId    String?
  manager      User?    @relation("UserReportingManager", fields: [managerId], references: [id])
  reportees      User[]   @relation("UserReportingManager")

  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  managedDepartment Department[] @relation("DepartmentLead")
  onboardingInvites OnboardingInvite[] @relation("OnboardingInviteManager")
  employeeProfile EmployeeProfile?

  userRoles UserRole[]
  attendances Attendance[]
  leaveRequests LeaveRequest[]
  leaveRequestAsReporting LeaveRequest[] @relation("LeaveRequestReportingManager")
  leaveRequestAsAdmin LeaveRequest[] @relation("LeaveRequestCompanyAdmin")
  leaveApprovalIsGiven LeaveApproval[]
  payrolls Payroll[]
  bankAccount EmployeeBankAccount?
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])
  @@unique([userId, roleId])
}

// model ManagerProfile {
//   id       String   @id @default(uuid())
//   userId    String   @unique
//   teamSize Int?
//   user      User     @relation(fields: [userId], references: [id])
// }

model Organization {
  id       String   @id @default(uuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id])

  name     String
  logoUrl  String?
  industry  String?
  companySize String?

  //Address
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?
  pinCode   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id        String   @id @default(uuid())

  tenantId  String?
  tenant    Tenant?   @relation(fields: [tenantId], references: [id])

  key       String
  value     Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
}

model Department {
  id       String   @id @default(uuid())
  name     String
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id])

  managerId String?
  manager    User?    @relation("DepartmentLead", fields: [managerId], references: [id])
  
  users      User[]   @relation("DepartmentUsers")
  designations Designation[]
  onboardingInvites OnboardingInvite[]
  payStructures PayStructure[]

  @@unique([name, tenantId]) // Ensure department names are unique within a tenant
}

model Designation {
  id           String      @id @default(uuid())
  name         String      // e.g., HR, Manager, Team Lead, Accountant

  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  
  departmentId String?     // optional if designation belongs to a department
  department   Department? @relation(fields: [departmentId], references: [id])

  users        User[]      // users holding this designation
  onboardingInvites OnboardingInvite[]
  payStructures PayStructure[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([name, tenantId]) // unique designation names per tenant
}

model SubscriptionPlan {
  id          String   @id @default(uuid())
  name        String   @unique // e.g., Free, Basic, Pro, Enterprise
  price       Float?
  isFree      Boolean  @default(false)
  
  maxUsers    Int?     // null for unlimited
  features    Json?
  createdAt   DateTime @default(now())

  tenantSubscriptions TenantSubscription[]
}

model TenantSubscription {
  id          String   @id @default(uuid())

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  
  planId      String
  plan        SubscriptionPlan @relation(fields: [planId], references: [id])
  
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean  @default(true)

  @@index([tenantId, isActive])
}

enum OnboardingInviteStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}

model OnboardingInvite {
  id        String   @id @default(uuid())

  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  email     String
  token     String   @unique
  status    OnboardingInviteStatus @default(PENDING)
  expiresAt DateTime

  firstName String?
  lastName  String?
  phone     String?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  designationId   String?
  designation     Designation? @relation(fields: [designationId], references: [id])

  managerId    String?
  manager      User?    @relation("OnboardingInviteManager", fields: [managerId], references: [id])

  roleId       String?
  role         Role?    @relation(fields: [roleId], references: [id])
  
  employeeCode String?
  joiningDate DateTime?
  proposedSalary      Float?

  submittedAt DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([email])
}

model EmployeeProfile {
  id        String   @id @default(uuid())

  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])

  employeeCode String? 
  joiningDate DateTime?
  salary      Float?
  dateOfBirth DateTime?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?
  pinCode      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
}

model AttendanceConfig {
  id           String   @id @default(uuid())

  tenantId     String   @unique
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  checkInTime  String // "09:00"
  checkOutTime String // "18:00"
  graceMinutes Int    // minutes after check-in time to be considered late

  halfDayMinutes Int @default(240) // minutes threshold for half-day - 4 hours
  fullDayMinutes Int @default(480) // minutes threshold for full-day - 8 hours

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attendance {
  id        String   @id @default(uuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  date      DateTime // date of attendance
  checkInAt  DateTime?
  checkOutAt DateTime?
  status    AttendanceStatus  @default(PRESENT)
  isLate    Boolean  @default(false)
  workedMinutes Int     @default(0)
  remarks   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
  @@index([tenantId, date])
}

enum LeaveTypeCode {
  CASUAL
  SICK
  MATERNITY
  PATERNITY
  EARNED
  UNPAID
}

enum LeaveRequestStatus {
  PENDING
  PARTIALLY_APPROVED
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveApprovalAction {
  PENDING
  APPROVE
  REJECT
}

model LeaveType {
  id        String   @id @default(uuid())

  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  name      String   // e.g., CASUAL, SICK, MATERNITY
  typeCode  LeaveTypeCode?
  maxLimits Int?     // e.g., max 12 casual leaves per year
  attachmentRequired Boolean @default(false)
  priorNoticeDays Int?  @default(0)
  allowHalfDay Boolean @default(false)
  sandwichLeaveAllowed Boolean @default(false) // if true, allows taking leave in between two working days
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaveRequests LeaveRequest[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model LeaveRequest {
  id        String   @id @default(uuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  startDate DateTime
  endDate   DateTime
  totalDays Float // can be fractional for half-day leaves 0.5

  reason    String?
  attachmentUrls String[]

  reportingManagerId String?
  reportingManager   User?    @relation("LeaveRequestReportingManager", fields: [reportingManagerId], references: [id])

  companyAdminId String?
  companyAdmin   User?    @relation("LeaveRequestCompanyAdmin", fields: [companyAdminId], references: [id])

  status    LeaveRequestStatus @default(PENDING)

  managerApprovedAt DateTime?
  adminApprovedAt DateTime?
  rejectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvals LeaveApproval[]

  @@index([tenantId, userId, status])
  @@index([tenantId, startDate, endDate])
}

model LeaveApproval {
  id        String   @id @default(uuid())

  leaveRequestId String
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id])

  approverId String
  approver   User     @relation(fields: [approverId], references: [id])

  status    LeaveApprovalAction @default(PENDING)
  remarks   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leaveRequestId, approverId]) // Ensure one approval action per approver per leave request
  @@index([approverId, status])
}

enum PayrollStatus {
  DRAFT
  PROCESSED
  DISBURSING
  PAID
  FAILED
  CANCELLED
}

enum PayrollItemType {
  EARNING
  ALLOWANCE
  DEDUCTION
  TAX
  BONUS
}

enum PayStructureCompType {
  BASIC
  ALLOWANCE
  DEDUCTION
}

enum PayStructureValueType {
  PERCENTAGE
  FLAT
}

enum DisbursementStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
}

model EmployeeBankAccount {
  id                String   @id @default(uuid())

  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])


  accountHolderName String
  accountNumber     String
  ifscCode          String
  bankName          String?
  branchName        String?
  upiId             String?

  isVerified        Boolean  @default(false)
  isPrimary         Boolean  @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model PayStructure {
  id                String   @id @default(uuid())

  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])

  name              String
  departmentId      String?
  department        Department? @relation(fields: [departmentId], references: [id])

  designationId     String?
  designation       Designation? @relation(fields: [designationId], references: [id])
  
  isDefault         Boolean  @default(false) // if true, applies to all employees without specific structure
  isActive          Boolean  @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  components        PayStructureComponent[]
  payrolls          Payroll[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model PayStructureComponent {
  id                String   @id @default(uuid())

  payStructureId    String
  payStructure      PayStructure @relation(fields: [payStructureId], references: [id])

  label             String
  type              PayStructureCompType
  valueType         PayStructureValueType
  value             Float // if percentage, value is % of basic, if flat, it's fixed amount
  isTaxable         Boolean  @default(false)
  attachmentRequired Boolean  @default(false)


  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Payroll {
  id                String   @id @default(uuid())

  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])

  payStructureId    String
  payStructure      PayStructure @relation(fields: [payStructureId], references: [id])

  userId            String
  user              User     @relation(fields: [userId], references: [id])

  month             Int // 1-12
  year              Int

  baseSalary        Float
  grossSalary       Float
  totalEarnings     Float @default(0)
  totalDeductions   Float @default(0)
  totalAllowances   Float @default(0)
  totalBonus        Float @default(0)
  totalTax          Float @default(0)
  netSalary         Float

  presentDays       Float @default(0)
  absentDays        Float @default(0)
  lateDays          Float @default(0)
  halfDays          Float @default(0)
  payableDays       Float @default(0)
  paidLeaves        Float @default(0)
  unpaidLeaves      Float @default(0)

  status            PayrollStatus @default(DRAFT)
  processedAt       DateTime?
  paidAt            DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  items             PayrollItem[]
  payslip           Payslip?

  @@unique([tenantId, userId, month, year])
  @@index([tenantId, userId, month, year])
}

model PayrollItem {
  id                String   @id @default(uuid())

  payrollId         String
  payroll           Payroll   @relation(fields: [payrollId], references: [id])

  label             String
  type              PayrollItemType
  amount            Float
  description       String?
  attachmentUrl     String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Payslip {
  id                String   @id @default(uuid())

  payrollId         String   @unique
  payroll           Payroll   @relation(fields: [payrollId], references: [id])

  fileUrl           String?    // URL to the generated payslip PDF
  generatedAt       DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}