// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  PENDING
  APPROVED
  REJECTED
}

model Tenant {
  id   String @id @default(uuid())
  name String

  status             TenantStatus         @default(PENDING) //🔥 WAIT FOR APPROVAL
  isActive           Boolean              @default(true)
  isSystem           Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  users              User[]
  roles              Role[]
  organization       Organization[]
  settings           Setting[]
  departments        Department[]
  designations       Designation[]
  subscription TenantSubscription[]
  onboardingInvites  OnboardingInvite[]
  attendanceConfigs  AttendanceConfig[]
  attendances        Attendance[]

  leaveTypes            LeaveType[]
  leaveRequests         LeaveRequest[]
  leavePolicies         LeavePolicy[]
  leaveApprovalPolicies LeaveApprovalPolicy[]
  leaveBalance          LeaveBalance[]
  holidayCalendars      HolidayCalendar[]
  holidays              Holiday[]
  outDuties             OutDuty[]
  feeds                 Feed[]

  payrolls      Payroll[]
  payStructures PayStructure[]
  payrollComponentMasters PayrollComponentMaster[]
  employeePayrollComponents employeePayrollComponent[]

  attendanceRegularizationPolicies AttendanceRegularizationPolicy[]
  attendanceRegularizationRequests AttendanceRegularizationRequest[]

  resignationRequests ResignationRequest[]
  resignationApprovalPolicies ResignationApprovalPolicy[]
}

enum RoleType {
  SYSTEM
  TENANT
}

model Role {
  id                        String                     @id @default(uuid())
  name                      String
  type                      RoleType
  tenantId                  String?
  tenant                    Tenant?                    @relation(fields: [tenantId], references: [id])
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  userRoles                 UserRole[]
  rolePermissions           RolePermission[]
  onboardingInvites         OnboardingInvite[]
  leaveApprovalPolicyLevels LeaveApprovalPolicyLevel[]

  isActive Boolean @default(true)

  @@unique([name, tenantId]) // Ensure role names are unique within a tenant
}

model Permission {
  id     String   @id @default(uuid())
  name   String
  scope  RoleType @default(SYSTEM) // e.g., SYSTEM | TENANT
  module String? // e.g., EMPLOYEE_MANAGEMENT
  action String? // e.g., CREATE, READ, UPDATE, DELETE

  createdAt DateTime @default(now())

  roles RolePermission[]

  @@unique([scope, module, action]) // Ensure unique permissions based on scope, module, and action
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique // 
  personalEmail String? @unique
  phone    String? @unique
  password String

  otp      String? // for passwordless login or 2FA
  otpExpiresAt DateTime?
  otpAttempts Int @default(0)
  otpRequestCount Int @default(0)
  otpRequestWindowAt DateTime?
  otpBlockedUntil DateTime?

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id]) // COMPANY

  departmentId String?
  department   Department? @relation("DepartmentUsers", fields: [departmentId], references: [id])

  designationId String?
  designation   Designation? @relation(fields: [designationId], references: [id])

  managerId String?
  manager   User?   @relation("UserReportingManager", fields: [managerId], references: [id])
  reportees User[]  @relation("UserReportingManager")

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  managedDepartment Department[]       @relation("DepartmentLead")
  onboardingInvites OnboardingInvite[] @relation("OnboardingInviteManager")
  employeeProfile   EmployeeProfile?

  userRoles                 UserRole[]
  attendances               Attendance[]
  leaveRequests             LeaveRequest[]
  leaveApprovalPolicyLevels LeaveApprovalPolicyLevel[]
  leaveApprovalIsGiven      LeaveApproval[]
  payrolls                  Payroll[]
  bankAccount               EmployeeBankAccount?
  leaveBalances             LeaveBalance[]
  employeePayrollComponents employeePayrollComponent[]

  outDuties    OutDuty[]
  markOutDuties OutDuty[] @relation("OutDutyMarkedBy")

  attendanceRegularizationRequests AttendanceRegularizationRequest[] @relation("AttendanceRegularizationRequester")
  approvedAttendanceRegularizations AttendanceRegularizationRequest[] @relation("AttendanceRegularizationApprovedBy")
  rejectedAttendanceRegularizations AttendanceRegularizationRequest[] @relation("AttendanceRegularizationRejectedBy")
  attendanceRegularizationPolicies AttendanceRegularizationPolicy[] @relation("AttendanceRegularizationPolicySpecificUser")

  createdFeeds Feed[] @relation("FeedActor")// feeds created by the user
  subjectFeeds Feed[] @relation("FeedSubjectUser") // feeds where the user is tagged or mentioned

  resignationRequests ResignationRequest[] @relation("ResignationRequester")
  approvedResignations ResignationRequest[] @relation("ResignationApprovedBy")
  rejectedResignations ResignationRequest[] @relation("ResignationRejectedBy")
  resignationApprovalPolicies ResignationApprovalPolicy[] @relation("ResignationPolicySpecificUser")

  feedComments FeedComment[]
  feedReactions FeedReaction[]
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

enum HolidayRegionType {
  GLOBAL
  COUNTRY
  STATE
  CITY
  CUSTOM
}

model Organization {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name        String
  logoUrl     String?
  industry    String?
  companySize String?

  //Address
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?
  pinCode      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id String @id @default(uuid())

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  key   String
  value Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
}

model Department {
  id       String @id @default(uuid())
  name     String
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  managerId String?
  manager   User?   @relation("DepartmentLead", fields: [managerId], references: [id])

  users                 User[]                @relation("DepartmentUsers")
  designations          Designation[]
  onboardingInvites     OnboardingInvite[]
  payStructures         PayStructure[]
  leaveApprovalPolicies LeaveApprovalPolicy[]
  attendanceRegularizationPolicies AttendanceRegularizationPolicy[]
  resignationApprovalPolicies ResignationApprovalPolicy[]
  feeds                  Feed[]

  @@unique([name, tenantId]) // Ensure department names are unique within a tenant
}

model Designation {
  id   String @id @default(uuid())
  name String // e.g., HR, Manager, Team Lead, Accountant

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  departmentId String? // optional if designation belongs to a department
  department   Department? @relation(fields: [departmentId], references: [id])

  users             User[] // users holding this designation
  onboardingInvites OnboardingInvite[]
  payStructures     PayStructure[]

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  leaveApprovalPolicies LeaveApprovalPolicy[]
  attendanceRegularizationPolicies AttendanceRegularizationPolicy[]
  resignationApprovalPolicies ResignationApprovalPolicy[]

  @@unique([name, tenantId]) // unique designation names per tenant
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

model SubscriptionModule {
  id String @id @default(uuid())

  key String @unique
  name String
  description String?

  isActive Boolean @default(true)

  monthlyPrice Float? @default(0)
  yearlyPrice  Float? @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  tenantSubscriptionModules TenantSubscriptionModule[]
}


// model SubscriptionPlan {
//   id     String  @id @default(uuid())
//   name   String  @unique // e.g., Free, Basic, Pro, Enterprise

//   isFree   Boolean @default(false)

//   isActive Boolean @default(true)

//   createdAt DateTime @default(now())
//   updatedAt DateTime @updatedAt @default(now())

// }

model TenantSubscription {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  billingCycle BillingCycle @default(MONTHLY)

  startDate DateTime
  endDate   DateTime?

  isActive  Boolean   @default(true)
  cancelledAt DateTime?

  modules    TenantSubscriptionModule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
}

model TenantSubscriptionModule {
  id String @id @default(uuid())

  subscriptionId String
  subscription   TenantSubscription @relation(fields: [subscriptionId], references: [id])

  moduleId String
  module   SubscriptionModule @relation(fields: [moduleId], references: [id])

  isEnabled Boolean @default(true)

  monthlyPrice Float? @default(0)
  yearlyPrice  Float? @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subscriptionId, moduleId])
}

enum OnboardingInviteStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}

model OnboardingInvite {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  email     String
  token     String                 @unique
  status    OnboardingInviteStatus @default(PENDING)
  expiresAt DateTime

  firstName String?
  lastName  String?
  phone     String?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  designationId String?
  designation   Designation? @relation(fields: [designationId], references: [id])

  managerId String?
  manager   User?   @relation("OnboardingInviteManager", fields: [managerId], references: [id])

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  employeeCode   String?
  joiningDate    DateTime?
  proposedSalary Float?

  sourceOfHire String? // e.g., LinkedIn, Referral, Job Portal

  submittedAt DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([email])
}

model EmployeeProfile {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  employeeCode   String?
  employmentType EmploymentType?

  joiningDate     DateTime?
  probationMonths Int?

  salary      Float?
  dateOfBirth DateTime?

  bloodGroup   String?
  photoUrl     String?

  panNumber    String? @unique
  aadharNumber String? @unique

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?
  pinCode      String?

  sourceOfHire String? // e.g., LinkedIn, Referral, Job Portal

  exitDate DateTime?
  exitReason String?

  familyMembers  EmployeeFamilyMember[]
  experiences    EmployeeExperience[]
  qualifications EmployeeQualification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum FamilyRelation {
  FATHER
  MOTHER
  SPOUSE
  CHILD
  SIBLING
  OTHER
}

model EmployeeFamilyMember {
  id String @id @default(uuid())

  employeeProfileId String
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id])

  relation       FamilyRelation
  name           String
  dateOfBirth    DateTime?
  phone  String?
  email          String?
  occupation     String?
  isDependent    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeProfileId])
}

model EmployeeExperience {
  id String @id @default(uuid())

  employeeProfileId String
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id])

  companyName  String
  jobTitle     String?
  startDate    DateTime?
  endDate      DateTime?
  isCurrent     Boolean @default(false)
  description   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeProfileId])
}

model EmployeeQualification {
  id String @id @default(uuid())

  employeeProfileId String
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id])

  degree       String
  institution   String?
  fieldOfStudy String?
  startYear    Int?
  endYear      Int?
  grade        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeProfileId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  WEEK_OFF
  OUT_DUTY
  REGULARIZED
}

model AttendanceConfig {
  id String @id @default(uuid())

  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  checkInTime  String // "09:00"
  checkOutTime String // "18:00"
  graceMinutes Int // minutes after check-in time to be considered late

  halfDayMinutes Int @default(240) // minutes threshold for half-day - 4 hours
  fullDayMinutes Int @default(480) // minutes threshold for full-day - 8 hours

  locationEnabled Boolean @default(false)

  workingDays    Json // e.g., ["MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY"]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AttendanceRegularizationPolicy {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name     String

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  designationId String?
  designation   Designation? @relation(fields: [designationId], references: [id])

  approverType LeaveApproverType

  userId String? // if approverType is SPECIFIC_USER
  user   User?   @relation("AttendanceRegularizationPolicySpecificUser",fields: [userId], references: [id])

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, departmentId, designationId, isActive])
}

enum RegularizationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model AttendanceRegularizationRequest {
id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  userId String
  user   User @relation("AttendanceRegularizationRequester",fields: [userId], references: [id])

  attendanceId String?
  attendance   Attendance? @relation(fields: [attendanceId], references: [id])

  date DateTime

  requestedCheckInAt DateTime?
  requestedCheckOutAt DateTime?

  reason String

  status RegularizationStatus @default(PENDING)

  approvedById String?
  approvedBy   User? @relation("AttendanceRegularizationApprovedBy", fields: [approvedById], references: [id])

  rejectedById String?
  rejectedBy   User? @relation("AttendanceRegularizationRejectedBy", fields: [rejectedById], references: [id])

  approverType LeaveApproverType?
  approverUserId String?
  approverRoleId String?

  approvedAt DateTime?
  rejectedAt DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, userId, status])
  @@index([tenantId, date])
}

model Attendance {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  date          DateTime // date of attendance
  checkInAt     DateTime?
  checkOutAt    DateTime?

  checkInLat Float?
  checkInLng Float?
  checkInAddress String?

  checkOutLat Float?
  checkOutLng Float?
  checkOutAddress String?

  status        AttendanceStatus @default(PRESENT)
  isLate        Boolean          @default(false)
  workedMinutes Int              @default(0)
  remarks       String?

  leaveRequestId String?
  leaveRequest   LeaveRequest? @relation(fields: [leaveRequestId], references: [id])

  isOnApprovedLeave Boolean @default(false)
  isPaidLeave     Boolean @default(false)
  isHoliday      Boolean @default(false)
  isWeekOff     Boolean @default(false)

  isOutDuty     Boolean @default(false)
  outDutyReason String?

  regularizedAt DateTime?
  regularizedById String?
  regularizationReason String?

  manuallyUpdatedAt DateTime?
  manuallyUpdatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  regularizationRequests AttendanceRegularizationRequest[]

  @@unique([userId, date])
  @@index([userId, date])
  @@index([tenantId, date])
  @@index([tenantId, status, date])
}

enum OutDutyStatus {
  APPROVED
  CANCELLED
}

model OutDuty {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  userId String
  user User @relation(fields: [userId], references: [id])

  markedById String
  markedBy User @relation("OutDutyMarkedBy", fields: [markedById], references: [id])

  startDate DateTime
  endDate DateTime

  reason String
  status OutDutyStatus @default(APPROVED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, userId, startDate, endDate])
}

enum EmploymentType {
  FULL_TIME
  TRAINEE
  INTERN
  CONTRACT
  OTHER
}

enum LeaveTypeCode {
  CASUAL
  SICK
  MATERNITY
  PATERNITY
  EARNED
  UNPAID
}

enum LeaveRequestStatus {
  PENDING
  PARTIALLY_APPROVED
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveApprovalAction {
  PENDING
  APPROVE
  REJECT
}

enum LeaveApproverType {
  REPORTING_MANAGER
  DEPARTMENT_MANAGER
  COMPANY_ADMIN
  SPECIFIC_USER
  ROLE
}

enum LeaveAccrualFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum LeaveCountMode {
  CALENDAR_DAYS
  WORKING_DAYS
}

model LeaveBalance {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  year Int

  allocatedDays      Float @default(0) // total allocated leaves for the year
  takenDays          Float @default(0) // total leaves taken
  carriedForwardDays Float @default(0) // leaves carried forward from previous year
  usedDays           Float @default(0) // total used leaves (taken + carried forward)
  remainingDays      Float @default(0) // calculated as allocated + carried forward - used

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId, leaveTypeId, year])
  @@index([tenantId, userId, year])
}

model LeaveType {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name     String // e.g., CASUAL, SICK, MATERNITY
  typeCode LeaveTypeCode?
  isActive Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaveRequests    LeaveRequest[]
  leavePolicyRules LeavePolicyRule[]
  approvalPolicies LeaveApprovalPolicy[]
  leaveBalances    LeaveBalance[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model LeavePolicy {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name            String
  employmentType  EmploymentType?
  probationMonths Int?            @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rules            LeavePolicyRule[]
  leaveRequests    LeaveRequest[]
  approvalPolicies LeaveApprovalPolicy[]

  @@unique([tenantId, name])
  @@index([tenantId, employmentType, isActive])
}

model LeavePolicyRule {
  id String @id @default(uuid())

  leavePolicyId String
  leavePolicy   LeavePolicy @relation(fields: [leavePolicyId], references: [id])

  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  annualAllocation   Float  @default(0)
  maxPerRequest      Float?
  maxPerYear         Float?
  maxConsecutiveDays Float?

  allowDuringProbation Boolean @default(false)
  attachmentRequired   Boolean @default(false)
  priorNoticeDays      Int? // number of days in advance the leave request must be made
  sandwichLeaveAllowed Boolean @default(false)
  countMode             LeaveCountMode @default(WORKING_DAYS)

  isPaid Boolean @default(true)

  carryForwardAllowed Boolean @default(false)
  carryForwardLimit   Float? // max days that can be carried forward

  accrualFrequency LeaveAccrualFrequency?
  accrualAmount    Float? // amount to accrue based on frequency (e.g., 1

  regionHolidayCalenderId String? // if leave accrual is based on region holidays
  holidayCalendar         HolidayCalendar? @relation(fields: [regionHolidayCalenderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaveRequests LeaveRequest[]

  @@unique([leavePolicyId, leaveTypeId])
  @@index([leaveTypeId])
}

model LeaveApprovalPolicy {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name String

  leavePolicyId String?
  leavePolicy   LeavePolicy? @relation(fields: [leavePolicyId], references: [id])

  leaveTypeId String?
  leaveType   LeaveType? @relation(fields: [leaveTypeId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  designationId String?
  designation   Designation? @relation(fields: [designationId], references: [id])

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  levels        LeaveApprovalPolicyLevel[]
  leaveRequests LeaveRequest[]

  @@unique([tenantId, name])
}

model LeaveApprovalPolicyLevel {
  id String @id @default(uuid())

  approvalPolicyId String
  approvalPolicy   LeaveApprovalPolicy @relation(fields: [approvalPolicyId], references: [id])

  level        Int // 1 for first level approver, 2 for second level, etc.
  approverType LeaveApproverType

  roleId String? // if approverType is ROLE
  role   Role?   @relation(fields: [roleId], references: [id])

  userId String? // if approverType is SPECIFIC_USER
  user   User?   @relation(fields: [userId], references: [id])

  minApprovals Int? @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([approvalPolicyId, level])
  @@index([approvalPolicyId, level])
}

model LeaveRequest {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  leavePolicyId String
  leavePolicy   LeavePolicy @relation(fields: [leavePolicyId], references: [id])

  leavePolicyRuleId String?
  leavePolicyRule   LeavePolicyRule? @relation(fields: [leavePolicyRuleId], references: [id])

  approvalPolicyId String?
  approvalPolicy   LeaveApprovalPolicy? @relation(fields: [approvalPolicyId], references: [id])

  startDate DateTime
  endDate   DateTime
  totalDays Float // can be fractional for half-day leaves 0.5

  reason         String?
  attachmentUrls String[]

  currentApprovalLevel Int                @default(1) // tracks which approval level the request is currently at
  status               LeaveRequestStatus @default(PENDING)

  approvedAt DateTime?
  rejectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvals LeaveApproval[]
  attendances Attendance[]

  @@index([tenantId, userId, status])
  @@index([tenantId, startDate, endDate])
}

model LeaveApproval {
  id String @id @default(uuid())

  leaveRequestId String
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id])

  level Int // approval level this action corresponds to

  approverId String
  approver   User   @relation(fields: [approverId], references: [id])

  decision LeaveApprovalAction @default(PENDING)
  remarks  String?
  actedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leaveRequestId, approverId, level]) // Ensure one approval action per approver per leave request
  @@index([approverId, decision])
  @@index([leaveRequestId, level])
}

model HolidayCalendar {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name       String
  regionType HolidayRegionType @default(GLOBAL)
  country    String?
  state      String?
  city       String?
  year       Int?

  isDefault Boolean @default(false) // if true, applies to all employees without specific calendar
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  holidays         Holiday[]
  leavePolicyRules LeavePolicyRule[]

  @@unique([tenantId, name])
}

model Holiday {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  holidayCalendarId String
  holidayCalendar   HolidayCalendar @relation(fields: [holidayCalendarId], references: [id])

  name       String
  date       DateTime
  isOptional Boolean  @default(false) // if true, employees can choose to work on this day or take it as leave

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([holidayCalendarId, date])
  @@index([tenantId, date])
}

enum PayrollStatus {
  DRAFT
  PROCESSED
  DISBURSING
  PAID
  FAILED
  CANCELLED
}

enum PayrollItemType {
  EARNING
  ALLOWANCE
  DEDUCTION
  TAX
  BONUS
}

enum PayStructureValueType {
  PERCENTAGE_OF_BASIC
  COMPANY_FIXED
  EMPLOYEE_FIXED
  CUSTOM
}

enum DisbursementStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
}

enum PayrollComponentFreq {
  MONTHLY
  QUARTERLY
  YEARLY
}

model EmployeeBankAccount {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  accountHolderName String
  accountNumber     String
  ifscCode          String
  bankName          String?
  branchName        String?
  upiId             String?

  isVerified Boolean @default(false)
  isPrimary  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PayStructure {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name         String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  designationId String?
  designation   Designation? @relation(fields: [designationId], references: [id])

  isDefault Boolean @default(false) // if true, applies to all employees without specific structure
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  components PayStructureComponent[]
  payrolls   Payroll[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}



model PayrollItem {
  id String @id @default(uuid())

  payrollId String
  payroll   Payroll @relation(fields: [payrollId], references: [id])

  label         String
  type          PayrollItemType
  amount        Float
  description   String?
  attachmentUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payslip {
  id String @id @default(uuid())

  payrollId String  @unique
  payroll   Payroll @relation(fields: [payrollId], references: [id])

  fileUrl     String? // URL to the generated payslip PDF
  generatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Master data defination layer
model PayrollComponentMaster {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name        String
  type        PayrollItemType
  valueType   PayStructureValueType
  defaultValue Float? // used if valueType is COMPANY_FIXED or EMPLOYEE_FIXED

  isOptional    Boolean @default(false)
  isTaxable    Boolean @default(false)
  isActive     Boolean @default(true)

  includeInPayroll Boolean @default(true)
  allowAttendanceLink Boolean @default(false)
  allowLeaveLink   Boolean @default(false)
  frequency        PayrollComponentFreq?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payStructureComponents PayStructureComponent[]
  employeePayrollComponents employeePayrollComponent[]

  @@unique([tenantId, name])
  @@index([tenantId, type, isActive])
}

model PayStructureComponent {
  id String @id @default(uuid())

  payStructureId String
  payStructure   PayStructure @relation(fields: [payStructureId], references: [id])

  payrollMasterComponentId String
  payrollMasterComponent   PayrollComponentMaster @relation(fields: [payrollMasterComponentId], references: [id])

  valueType PayStructureValueType
  value     Float? // if valueType is PERCENTAGE_OF_BASIC, this represents the percentage
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([payStructureId, payrollMasterComponentId])
  @@index([payrollMasterComponentId, isActive])
  @@index([payStructureId, isActive])
}

model employeePayrollComponent {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  payrollMasterComponentId String
  payrollMasterComponent   PayrollComponentMaster @relation(fields: [payrollMasterComponentId], references: [id])

  valueType PayStructureValueType
  value     Float // if valueType is PERCENTAGE_OF_BASIC, this represents the percentage
  isActive  Boolean @default(true)
  remarks  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, payrollMasterComponentId])
  @@index([payrollMasterComponentId, isActive])
}

model Payroll {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  payStructureId String
  payStructure   PayStructure @relation(fields: [payStructureId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  month Int // 1-12
  year  Int

  baseSalary      Float
  grossSalary     Float
  totalEarnings   Float @default(0)
  totalDeductions Float @default(0)
  totalAllowances Float @default(0)
  totalBonus      Float @default(0)
  totalTax        Float @default(0)
  netSalary       Float

  presentDays  Float @default(0)
  absentDays   Float @default(0)
  lateDays     Float @default(0)
  halfDays     Float @default(0)
  payableDays  Float @default(0)
  paidLeaves   Float @default(0)
  unpaidLeaves Float @default(0)

  status      PayrollStatus @default(DRAFT)
  processedAt DateTime?
  paidAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items   PayrollItem[]
  payslip Payslip?

  @@unique([tenantId, userId, month, year])
  @@index([tenantId, userId, month, year])
}

enum FeedType {
  POST // manual HR/admin post
  EVENT // automatically generated from events like work anniversaries, birthdays, etc.
}

model Feed {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  actorId String? // user who triggered the feed, can be null for system-generated events
  actor   User?   @relation("FeedActor",fields: [actorId], references: [id])

  subjectedUserId String? // user related to the feed event, e.g., the employee having a work anniversary
  subjectedUser   User?   @relation("FeedSubjectUser",fields: [subjectedUserId], references: [id])

  departmentId String? // if feed is related to a department event
  department   Department? @relation(fields: [departmentId], references: [id])

  type FeedType

  content String? // text content of the feed
  metadata Json? // additional data like event type, user mentions, etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments FeedComment[]
  reactions FeedReaction[]

  @@index([tenantId, createdAt])
  @@index([tenantId, departmentId])
  @@index([tenantId, type])
}

model FeedComment {
  id String @id @default(uuid())

  feedId String
  feed   Feed   @relation(fields: [feedId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([feedId])
  @@index([userId])
}

// Reaction to feed posts, e.g., likes, emojis, etc.
enum ReactionType {
  LIKE
  LOVE
  CLAP
  CELEBRATE
}

model FeedReaction {
  id String @id @default(uuid())

  feedId String
  feed   Feed   @relation(fields: [feedId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  type ReactionType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([feedId, userId]) // one reaction per user per feed
}


enum ResignationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
  CANCELLED
  COMPLETED
}


model ResignationApprovalPolicy {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name String

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  designationId String?
  designation   Designation? @relation(fields: [designationId], references: [id])

  approverType LeaveApproverType

  userId String?
  user   User? @relation("ResignationPolicySpecificUser", fields: [userId], references: [id])

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, departmentId, designationId, isActive])
}

model ResignationRequest {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  userId String
  user   User @relation("ResignationRequester", fields: [userId], references: [id])

  reason String

  preferredLastWorkingDate DateTime?
  approvedLastWorkingDate  DateTime?

  status ResignationStatus @default(PENDING)

  approverType   LeaveApproverType?
  approverUserId String?

  approvedById String?
  approvedBy   User? @relation("ResignationApprovedBy", fields: [approvedById], references: [id])

  rejectedById String?
  rejectedBy   User? @relation("ResignationRejectedBy", fields: [rejectedById], references: [id])

  adminRemarks String?

  rejectedAt DateTime?
  approvedAt DateTime?
  withdrawnAt DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, userId, status])
  @@index([tenantId, status])
}